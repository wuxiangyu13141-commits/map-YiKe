<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width,initial-scale=1.0" />
<title>内蒙古经济发展可视化</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Orbitron:wght@500;700&family=Noto+Sans+SC:wght@400;700&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="css/style.css"/>
</head>
<body>
<!-- ══ Home 按钮 ══ -->
<div id="homeBtn" style="display:none">⌂ Home</div>
<!-- ══ Landing — 问题画廊 · 巨型字体排版风格 ══ -->
<div id="landingPage">
  <canvas id="landingSphere"></canvas>
  <div class="land-noise"></div>
  <div class="land-scanline"></div>
  <!-- 巨型散落文字 — 内蒙古特色 -->
  <div class="land-typo-bg" aria-hidden="true">
    <span class="typo-word typo-w1">草原</span>
    <span class="typo-word typo-w2">WIND</span>
    <span class="typo-word typo-w3">绿电</span>
    <span class="typo-word typo-w4">煤炭</span>
    <span class="typo-word typo-w5">GREEN</span>
  </div>
  <!-- 天空 + 草原色彩渐变 -->
  <div class="land-sky-glow" aria-hidden="true"></div>
  <div class="land-grass-glow" aria-hidden="true"></div>
  <!-- 蒙古回纹竖线分割 -->
  <div class="land-vert-divide" aria-hidden="true">
    <div class="vd-line vd-line-top"></div>
    <svg class="vd-knot" viewBox="0 0 32 32">
      <rect x="4" y="4" width="24" height="24" rx="1" fill="none" stroke="currentColor" stroke-width=".7"/>
      <rect x="9" y="9" width="14" height="14" rx="1" fill="none" stroke="currentColor" stroke-width=".5"/>
      <line x1="16" y1="4" x2="16" y2="9" stroke="currentColor" stroke-width=".5"/>
      <line x1="16" y1="23" x2="16" y2="28" stroke="currentColor" stroke-width=".5"/>
      <line x1="4" y1="16" x2="9" y2="16" stroke="currentColor" stroke-width=".5"/>
      <line x1="23" y1="16" x2="28" y2="16" stroke="currentColor" stroke-width=".5"/>
    </svg>
    <div class="vd-line vd-line-bot"></div>
  </div>
  <!-- 蒙古云纹装饰带 -->
  <div class="land-mongol-deco" aria-hidden="true">
    <svg viewBox="0 0 200 36" class="mongol-cloud"><path d="M0 18 Q8 2,16 18 Q24 2,32 18 Q40 2,48 18 Q56 2,64 18 Q72 2,80 18 Q88 2,96 18 Q104 2,112 18 Q120 2,128 18 Q136 2,144 18 Q152 2,160 18 Q168 2,176 18 Q184 2,192 18 L200 18" fill="none" stroke="currentColor" stroke-width="1"/><path d="M0 24 Q8 8,16 24 Q24 8,32 24 Q40 8,48 24 Q56 8,64 24 Q72 8,80 24 Q88 8,96 24" fill="none" stroke="currentColor" stroke-width=".6" opacity=".5"/></svg>
  </div>
  <!-- 右侧信息面板 -->
  <div class="land-right-info" aria-hidden="true">
    <div class="ri-label">COORDINATES</div>
    <div class="ri-data">40°N — 53°N</div>
    <div class="ri-data">97°E — 126°E</div>
    <div class="ri-gap"></div>
    <div class="ri-label">AREA</div>
    <div class="ri-data ri-data--lg">118.3<span>万 km²</span></div>
    <div class="ri-gap"></div>
    <div class="ri-label">BIOME</div>
    <div class="ri-data">温带草原 · 荒漠草原 · 森林草原</div>
    <div class="ri-gap"></div>
    <div class="ri-label">RESOURCE</div>
    <div class="ri-tags">
      <span class="ri-tag">风能</span>
      <span class="ri-tag">太阳能</span>
      <span class="ri-tag">煤炭</span>
      <span class="ri-tag">稀土</span>
    </div>
  </div>
  <!-- 蒙古角花纹 — 四角 -->
  <div class="land-corner land-corner--tl" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M4 44 L4 4 L44 4" fill="none" stroke="currentColor" stroke-width=".8"/><path d="M10 38 L10 10 L38 10" fill="none" stroke="currentColor" stroke-width=".5"/><path d="M4 4 L10 10" fill="none" stroke="currentColor" stroke-width=".5"/></svg></div>
  <div class="land-corner land-corner--tr" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M44 44 L44 4 L4 4" fill="none" stroke="currentColor" stroke-width=".8"/><path d="M38 38 L38 10 L10 10" fill="none" stroke="currentColor" stroke-width=".5"/><path d="M44 4 L38 10" fill="none" stroke="currentColor" stroke-width=".5"/></svg></div>
  <div class="land-corner land-corner--bl" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M4 4 L4 44 L44 44" fill="none" stroke="currentColor" stroke-width=".8"/><path d="M10 10 L10 38 L38 38" fill="none" stroke="currentColor" stroke-width=".5"/><path d="M4 44 L10 38" fill="none" stroke="currentColor" stroke-width=".5"/></svg></div>
  <div class="land-corner land-corner--br" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M44 4 L44 44 L4 44" fill="none" stroke="currentColor" stroke-width=".8"/><path d="M38 10 L38 38 L10 38" fill="none" stroke="currentColor" stroke-width=".5"/><path d="M44 44 L38 38" fill="none" stroke="currentColor" stroke-width=".5"/></svg></div>
  <!-- 哈木尔纹（卷草纹）上方装饰 -->
  <div class="land-khamr" aria-hidden="true">
    <svg viewBox="0 0 400 30" preserveAspectRatio="none">
      <path d="M0 28 C20 28,25 15,40 15 C55 15,55 2,70 2 C85 2,85 15,100 15 C115 15,120 28,140 28 C160 28,165 15,180 15 C195 15,195 2,210 2 C225 2,225 15,240 15 C255 15,260 28,280 28 C300 28,305 15,320 15 C335 15,335 2,350 2 C365 2,365 15,380 15 C395 15,400 28,400 28" fill="none" stroke="currentColor" stroke-width=".8"/>
    </svg>
  </div>
  <!-- 左上角标识 -->
  <div class="land-logo">INNER MONGOLIA<br><span>ECONOMIC OBSERVATORY</span></div>
  <!-- 右上角编号 -->
  <div class="land-idx">XY.2026</div>
  <!-- 底部导航线 -->
  <div class="land-bottom-line"></div>
  <!-- 底部蒙古连续回纹 -->
  <div class="land-hee-border" aria-hidden="true">
    <svg viewBox="0 0 480 12" preserveAspectRatio="none">
      <path d="M0 6 h8 v-5 h5 v5 h5 v5 h5 v-5 h5 v-5 h5 v5 h5 v5 h5 v-5 h5 v-5 h5 v5 h5 v5 h5 v-5 h5 v-5 h5 v5 h5 v5 h5 v-5 h5 v-5 h5 v5 h5 v5 h5 v-5 h5 v-5 h5 v5 h5 v5 h5 v-5 h5 v-5 h5 v5 h5 v5 h5 v-5 h5 v-5 h5 v5 h5 v5 h5 v-5 h5 v-5 h5 v5 h5 v5 h5 v-5 h5 v-5 h5 v5 h5 v5 h5 v-5 h8" fill="none" stroke="currentColor" stroke-width=".7"/>
    </svg>
  </div>
  <div class="land-bottom-hint">SCROLL TO EXPLORE</div>
  <!-- 自由探索入口 -->
  <div class="land-free-explore" id="landFreeExplore">
    <div class="lfe-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><line x1="2" y1="12" x2="22" y2="12"/></svg>
    </div>
    <div class="lfe-text">
      <span class="lfe-label">FREE EXPLORE</span>
      <span class="lfe-desc">自由探索 · 全景数据地图</span>
    </div>
    <span class="lfe-arrow">→</span>
  </div>
  <!-- 主内容：问题列表 -->
  <div class="land-questions">
    <div class="land-q-scroll">
    <div class="land-q land-q--active q-card--active" data-q="0">
      <div class="land-q-num">01</div>
      <div class="land-q-text">要么产业升维，要么资源枯竭：<br>内蒙古的<em>‘绿电狂飙’</em>，究竟是<em>背水一战</em>还是<em>降维打击</em>？</div>
      <div class="land-q-sub">七幕叙事 · 22 组核心指标 · 数据驱动</div>
      <div class="land-q-cta"><span>开始解答</span><span class="land-q-arrow">→</span></div>
    </div>
    <div class="land-q land-q--active q-card--q2" data-q="1">
      <div class="land-q-num">02</div>
      <div class="land-q-text">一盒奶只赚几毛钱，运费贵上天：<br>内蒙古凭什么靠最笨重的<em>'水生意'</em>，砸出<em>千亿商业帝国</em>？</div>
      <div class="land-q-sub">六幕叙事 · 乳业全景 · 数据驱动</div>
      <div class="land-q-cta"><span>开始解答</span><span class="land-q-arrow">→</span></div>
    </div>
    <div class="land-q land-q--pending" data-q="2">
      <div class="land-q-num">03</div>
      <div class="land-q-text">在零下几十度的冻土里<em>'淘金'</em>：<br>内蒙古凭什么把最冷的旱地，爆改为称霸全球的<em>冷凉农业帝国</em>？</div>
      <div class="land-q-badge">敬请期待</div>
    </div>
    <div class="land-q land-q--pending" data-q="3">
      <div class="land-q-num">04</div>
      <div class="land-q-text">把几万平方公里的<em>'死亡之海'</em>当做底牌：<br>内蒙古如何硬核做局，榨出年入百亿的<em>超级生态账本</em>？</div>
      <div class="land-q-badge">敬请期待</div>
    </div>
    <div class="land-q land-q--pending" data-q="4">
      <div class="land-q-num">05</div>
      <div class="land-q-text">不靠海不沿江的内陆绝地：<br>内蒙古凭什么在草原上空，硬核织出一张截流亚欧财富的<em>'超级货运网'</em>？</div>
      <div class="land-q-badge">敬请期待</div>
    </div>
    <div class="land-q land-q--pending" data-q="5">
      <div class="land-q-num">06</div>
      <div class="land-q-text">把零下30度的<em>'极寒诅咒'</em>当做天然冷库：<br>内蒙古如何逆天改命，砸出称霸全国的<em>冷链食品巨兽</em>？</div>
      <div class="land-q-badge">敬请期待</div>
    </div>
    <div class="land-q land-q--pending" data-q="6">
      <div class="land-q-num">07</div>
      <div class="land-q-text">掌控全球七成的<em>'软黄金'</em>：<br>内蒙古凭什么靠一撮羊绒，硬核收割国际顶奢供应链的<em>暴利</em>？</div>
      <div class="land-q-badge">敬请期待</div>
    </div>
    <div class="land-q land-q--pending" data-q="7">
      <div class="land-q-num">08</div>
      <div class="land-q-text">称霸全国七成的<em>瓜子大盘</em>：<br>巴彦淖尔如何靠几毛钱的零食，磕出一个极其恐怖的<em>百亿级农产帝国</em>？</div>
      <div class="land-q-badge">敬请期待</div>
    </div>
    <div class="land-q land-q--pending" data-q="8">
      <div class="land-q-num">09</div>
      <div class="land-q-text">死磕动力电池的<em>'隐形心脏'</em>：<br>被忽略的内蒙古，凭什么靠无人工厂悄悄拿捏了<em>全球新能源的命门</em>？</div>
      <div class="land-q-badge">敬请期待</div>
    </div>
    <div class="land-q land-q--pending" data-q="9">
      <div class="land-q-num">10</div>
      <div class="land-q-text">手握全国最便宜的电，却死磕最费钱的内燃机：<br>内蒙古的百万老司机，到底算清了怎样一笔残酷的<em>'极寒经济账'</em>？</div>
      <div class="land-q-badge">敬请期待</div>
    </div>
    <div class="land-q land-q--pending" data-q="10">
      <div class="land-q-num">11</div>
      <div class="land-q-text">敬请期待</div>
    </div>
    <div class="land-q land-q--pending" data-q="11">
      <div class="land-q-num">12</div>
      <div class="land-q-text">敬请期待</div>
    </div>
    </div>
  </div>
</div>

<!-- ══ 电影导演模式 ══ -->
<div id="cinematicMode" style="display:none">
  <div class="letterbox letterbox-top"></div>
  <div class="letterbox letterbox-bottom"></div>
  <div class="cm-narration" id="cmNarration">
    <div class="cm-act-label" id="cmActLabel">ACT I</div>
    <div class="cm-act-title" id="cmActTitle">繁荣的表象</div>
    <div class="cm-act-text" id="cmActText"></div>
  </div>
  <div class="cm-glass-panel" id="cmGlassPanel">
    <div class="cm-panel-header" id="cmPanelHeader"></div>
    <div class="cm-chart" id="cmChart"></div>
    <div class="cm-panel-insight" id="cmPanelInsight"></div>
  </div>
  <!-- 全幕通用电影叙事叠层 -->
  <div class="cm-act-ov" id="cmActOv" style="display:none">
    <div class="ao-title" id="aoTitle">
      <div class="ao-label" id="aoLabel"></div>
      <div class="ao-heading" id="aoHeading"></div>
    </div>
    <div class="ao-hud" id="aoHud">
      <div class="ao-counter" id="aoCounter"></div>
      <div class="ao-kpi-row" id="aoKpiRow"></div>
      <div class="ao-insight" id="aoInsight"></div>
    </div>
    <div class="ao-typewriter" id="aoTypewriter" style="display:none"></div>
    <div class="ao-end-btns" id="aoEndBtns" style="display:none">
      <div class="ao-end-btn ao-end-explore" id="aoEndExplore"><span class="btn-icon">▶</span> 自由探索</div>
      <div class="ao-end-btn ao-end-more" id="aoEndMore"><span class="btn-icon">◈</span> 更多问题解答</div>
    </div>
    <div class="ao-chart-wrap" id="aoChartWrap" style="display:none">
      <div id="aoChartEl" style="width:100%;height:100%"></div>
    </div>
  </div>
  <canvas id="cmCanvas"></canvas>
  <div class="cm-progress" id="cmProgress">
    <div class="cm-prog-dots" id="cmProgDots">
      <div class="cm-prog-dot active" data-act="0"><span>推I</span></div>
      <div class="cm-prog-dot" data-act="1"><span>推II</span></div>
      <div class="cm-prog-dot" data-act="2"><span>拉I</span></div>
      <div class="cm-prog-dot" data-act="3"><span>拉II</span></div>
      <div class="cm-prog-dot" data-act="4"><span>拉III</span></div>
      <div class="cm-prog-dot" data-act="5"><span>拉IV</span></div>
      <div class="cm-prog-dot" data-act="6"><span>终</span></div>
    </div>
    <div class="cm-prog-next" id="cmNext">下一幕 ›</div>
    <div class="cm-exit" id="cmExit">✕ 退出</div>
  </div>
  <!-- 幕间黑幕过渡 -->
  <div class="cm-blackout" id="cmBlackout"></div>
</div>

<!-- Q2 乳业电影模式 -->
<div id="q2CinematicMode" style="display:none;opacity:0;transition:opacity 0.8s;position:fixed;inset:0;z-index:900;pointer-events:auto">
  <div class="cm-act-ov" id="q2Overlay" style="display:none">
    <div class="ao-title" id="q2Title">
      <div class="ao-label" id="q2Label"></div>
      <div class="ao-heading" id="q2Heading"></div>
    </div>
    <div class="ao-hud" id="q2Hud">
      <div class="ao-counter" id="q2Counter"></div>
      <div class="ao-kpi-row" id="q2KpiRow"></div>
      <div class="ao-insight" id="q2Insight"></div>
    </div>
    <div class="ao-typewriter" id="q2Typewriter" style="display:none"></div>
    <div class="ao-end-btns" id="q2EndBtns" style="display:none">
      <div class="ao-end-btn ao-end-explore" id="q2EndExplore"><span class="btn-icon">▶</span> 自由探索</div>
      <div class="ao-end-btn ao-end-more" id="q2EndMore"><span class="btn-icon">◈</span> 更多问题解答</div>
    </div>
    <div class="ao-chart-wrap" id="q2ChartWrap" style="display:none">
      <div id="q2ChartEl" style="width:100%;height:100%"></div>
    </div>
  </div>
  <canvas id="q2Canvas"></canvas>
  <!-- 伊利 / 蒙牛 产品大图 — Apple 风格伪3D -->
  <img id="q2ImgYili" class="q2-product-hero q2-product--left" src="img/伊利.png" alt="伊利纯牛奶" draggable="false"/>
  <img id="q2ImgMengniu" class="q2-product-hero q2-product--right" src="img/蒙牛.png" alt="蒙牛纯牛奶" draggable="false"/>
  <div class="cm-progress" id="q2Progress"></div>
  <div class="cm-prog-next" id="q2Next" style="position:fixed;bottom:30px;right:120px;z-index:920;cursor:pointer;color:rgba(255,255,255,0.6);font-size:14px">下一幕 ›</div>
  <div class="cm-exit" id="q2Exit" style="position:fixed;bottom:30px;right:30px;z-index:920;cursor:pointer;color:rgba(255,255,255,0.4);font-size:13px">✕ 退出</div>
</div>


<div id="globeViz"></div>
<div id="industryViz"><canvas id="indCanvas"></canvas></div>

<!-- ══ Page 3: 民生温度 — FUI 脉冲轨道 ══ -->
<div id="livelihoodViz">
  <canvas id="lh-bg-canvas"></canvas>
  <div class="lh-container" id="lhContainer"></div>
  <div class="lh-hover-card" id="lhHover"></div>
</div>

<!-- ══ Page 4: 人才着陆点 ══ -->
<div id="talentViz">
  <canvas id="t4EntranceCanvas"></canvas>
  <div id="talentChart"></div>
  <div class="t4-search">
    <div class="t4-search-hint">输入你的专业或想从事的职业，查看内蒙古相关岗位的薪资水平与就业前景</div>
    <div class="t4-search-row">
    <div class="t4-search-title">🔍 职业检索</div>
    <input class="t4-search-input" id="t4Input" placeholder="试试：护士、焊工、光伏、计算机…" />
    <div class="t4-search-tags" id="t4Tags">
      <span class="t4-tag" data-q="计算机">计算机</span>
      <span class="t4-tag" data-q="焊工">焊工</span>
      <span class="t4-tag" data-q="护士">护士</span>
      <span class="t4-tag" data-q="会计">会计</span>
      <span class="t4-tag" data-q="教师">教师</span>
      <span class="t4-tag" data-q="光伏">光伏</span>
      <span class="t4-tag" data-q="律师">律师</span>
      <span class="t4-tag" data-q="厨师">厨师</span>
      <span class="t4-tag" data-q="采矿">采矿</span>
      <span class="t4-tag" data-q="直播">直播</span>
    </div>
    <div class="t4-clear" id="t4Clear">✕ 清除筛选</div>
    </div>
  </div>
  <div class="t4-timeline">
    <label>年份</label>
    <span class="t4-tl-year" id="t4YearVal">2021</span>
    <input class="t4-tl-range" id="t4Slider" type="range" min="2021" max="2024" step="1" value="2021" />
  </div>
  <div class="t4-legend">
    <div class="t4-legend-head">图例说明</div>
    <div class="t4-legend-cats">
      <span><i style="background:rgba(212,160,100,.8)"></i>能源/制造</span>
      <span><i style="background:rgba(80,160,210,.8)"></i>科技/研发</span>
      <span><i style="background:rgba(200,180,120,.8)"></i>商贸/服务</span>
      <span><i style="background:rgba(120,185,170,.8)"></i>公共/事业</span>
    </div>
    <div class="t4-legend-axes">
      <span>横轴</span> 年薪（万元）&nbsp;&nbsp;<span>纵轴</span> 就业需求增速（%）<br/>
      <span>气泡大小</span> = 就业容量（万人）
    </div>
  </div>
  <div class="t4-card" id="t4Card"></div>
</div>

<canvas id="transOverlay"></canvas>

<!-- 城市产业详情面板 -->
<div class="city-panel" id="cityPanel">
  <div class="cp-header">
    <h3>🏭 <span id="cpTitle">呼和浩特</span></h3>
    <button class="cp-close" id="cpClose">✕</button>
  </div>
  <div class="cp-sub" id="cpSub">首府·大数据产业集群</div>
  <div class="cp-stats" id="cpStats"></div>
  <div class="cp-legend"><i style="background:#d26444"></i>传统工业 <i style="background:#00c8d0;box-shadow:0 0 4px rgba(0,200,210,.5);margin-left:8px"></i>科技产业</div>
  <div class="cp-bars" id="cpBars"></div>
  <div class="cp-desc" id="cpDesc"></div>
</div>

<section class="hud">
  <div class="hud-header">
    <div class="eyebrow">Inner Mongolia Economic Platform</div>
    <div class="title">内蒙古经济发展观察可视化</div>
    <div class="desc">对外贸易·煤炭能源·绿电算力 三维流向地图</div>
  </div>
  <div class="nav-btns">
    <div class="nav-btn active" data-page="1"><div class="nav-icon">🌐</div><div class="nav-label"><b>全球流向</b><small>FLOW</small></div></div>
    <div class="nav-btn" data-page="2"><div class="nav-icon">🏭</div><div class="nav-label"><b>产业重塑</b><small>INDUSTRY</small></div></div>
    <div class="nav-btn" data-page="3"><div class="nav-icon">🏠</div><div class="nav-label"><b>民生温度</b><small>LIVELIHOOD</small></div></div>
    <div class="nav-btn" data-page="4"><div class="nav-icon">🎓</div><div class="nav-label"><b>人才着陆点</b><small>TALENT</small></div></div>
  </div>

  <!-- ══ Page 1: 全球流向 HUD 内容 ══ -->
  <div id="page1Hud">
  <div class="stat-row" id="statRow">
    <div class="stat-card" style="--accent:rgba(0,200,220,.5);--accent-glow:rgba(0,200,255,.2)">
      <div class="stat-label">GDP</div>
      <div class="stat-val" id="sGdp">21584.8<span class="stat-unit">亿</span></div>
      <div class="stat-change up" id="sGdpChg">▲ 6.9%</div>
    </div>
    <div class="stat-card" style="--accent:rgba(212,160,80,.5);--accent-glow:rgba(212,160,80,.2)">
      <div class="stat-label">进出口总额</div>
      <div class="stat-val" id="sTrade">190.5<span class="stat-unit">亿$</span></div>
      <div class="stat-change up" id="sTradeChg">▲ 21%</div>
    </div>
    <div class="stat-card" style="--accent:rgba(0,200,208,.5);--accent-glow:rgba(0,200,208,.2)">
      <div class="stat-label">人均可支配收入</div>
      <div class="stat-val" id="sIncome">34108<span class="stat-unit">元</span></div>
      <div class="stat-change up" id="sIncChg">▲ 5.2%</div>
    </div>
    <div class="stat-card" style="--accent:rgba(168,120,224,.5);--accent-glow:rgba(168,120,224,.2)">
      <div class="stat-label">财政收入</div>
      <div class="stat-val" id="sFiscal">2349.9<span class="stat-unit">亿</span></div>
      <div class="stat-change up" id="sFiscChg">▲ 8.5%</div>
    </div>
  </div>
  <div class="chart-box" id="tradeChart">
    <div class="chart-title">贸易伙伴 TOP 6</div>
    <div id="chartBars"></div>
    <div class="chart-legend-row"><i style="background:#d4a050"></i>出口 <i style="background:#5098d8;margin-left:8px"></i>进口</div>
  </div>
  <div class="trade-summary">
    <div class="ts-title">贸易结构概览</div>
    <div class="ts-meters" id="tsMeters">
      <div class="ts-meter">
        <div class="ts-ring"><svg viewBox="0 0 40 40"><circle class="bg" cx="20" cy="20" r="16"/><circle class="fg" id="ringExp" cx="20" cy="20" r="16" stroke="#d4a050" stroke-dasharray="100.5" stroke-dashoffset="60"/></svg><div class="ts-pct" id="pctExp">40%</div></div>
        <div class="ts-meter-label">出口占比</div>
      </div>
      <div class="ts-meter">
        <div class="ts-ring"><svg viewBox="0 0 40 40"><circle class="bg" cx="20" cy="20" r="16"/><circle class="fg" id="ringImp" cx="20" cy="20" r="16" stroke="#5098d8" stroke-dasharray="100.5" stroke-dashoffset="40"/></svg><div class="ts-pct" id="pctImp">60%</div></div>
        <div class="ts-meter-label">进口占比</div>
      </div>
      <div class="ts-meter">
        <div class="ts-ring"><svg viewBox="0 0 40 40"><circle class="bg" cx="20" cy="20" r="16"/><circle class="fg" id="ringGreen" cx="20" cy="20" r="16" stroke="#00c8d0" stroke-dasharray="100.5" stroke-dashoffset="80"/></svg><div class="ts-pct" id="pctGreen">20%</div></div>
        <div class="ts-meter-label">绿电占比</div>
      </div>
    </div>
  </div>
  </div><!-- /page1Hud -->

  <!-- ══ Page 2: 产业重塑 HUD 内容 ══ -->
  <div id="page2Hud" style="display:none">
    <div class="ind-title-card">
      <div class="itc-eyebrow">Tectonic Industry Shift</div>
      <div class="itc-title">产业升级跃迁<br><span style="font-size:12px;color:rgba(0,200,210,.7)">科技产业高度连续三年跑赢传统工业</span></div>
      <div class="itc-desc">地壳底盘 = 传统工业产值（暗红熔岩）<br>全息高塔 = 科技新兴产业（荧光青色）<br>拖动时间轴观测 2021→2024 动态演变</div>
    </div>
    <div class="stat-row">
      <div class="stat-card" style="--accent:rgba(210,100,68,.5);--accent-glow:rgba(210,100,68,.2)">
        <div class="stat-label">第二产业</div>
        <div class="stat-val" id="sInd2">9646.5<span class="stat-unit">亿</span></div>
        <div class="stat-change up" id="sInd2Chg">▲ 6.8%</div>
      </div>
      <div class="stat-card" style="--accent:rgba(0,200,210,.5);--accent-glow:rgba(0,200,210,.2)">
        <div class="stat-label">科技支出</div>
        <div class="stat-val" id="sSciTech">35.3<span class="stat-unit">亿</span></div>
        <div class="stat-change up" id="sSciChg">▲ 22%</div>
      </div>
      <div class="stat-card" style="--accent:rgba(180,90,60,.5);--accent-glow:rgba(180,90,60,.2)">
        <div class="stat-label">工业增加值</div>
        <div class="stat-val" id="sIndVal">8360<span class="stat-unit">亿</span></div>
        <div class="stat-change up" id="sIndChg">▲ 5.2%</div>
      </div>
      <div class="stat-card" style="--accent:rgba(168,120,224,.5);--accent-glow:rgba(168,120,224,.2)">
        <div class="stat-label">电力信息投资</div>
        <div class="stat-val" id="sInfoRes">117.9<span class="stat-unit">亿</span></div>
        <div class="stat-change up" id="sInfoChg">▲ 18%</div>
      </div>
    </div>
    <div class="chart-box" id="industryCompare">
      <div class="chart-title">盟市新旧动能对比 TOP 6</div>
      <div id="industryBars"></div>
      <div class="chart-legend-row"><i style="background:#d26444"></i>传统工业 <i style="background:#00c8d0;margin-left:8px;box-shadow:0 0 6px rgba(0,200,210,.5)"></i>科技产业</div>
    </div>
  </div><!-- /page2Hud -->

  <!-- ══ Page 3: 民生温度 HUD 内容 ══ -->
  <div id="page3Hud" style="display:none">
    <div class="ind-title-card">
      <div class="itc-eyebrow">INNER MONGOLIA</div>
      <div class="itc-title">民生温度<br><span style="font-size:12px;color:rgba(200,180,160,.55)">城乡居民收入差距变迁</span></div>
      <div class="itc-desc">四城代表性样本：呼和浩特、包头、鄂尔多斯、赤峰<br>横轴映射人均可支配收入 · 连线越短差距越小<br>拖动时间轴观察 2021→2024 变化</div>
    </div>
    <div class="stat-row">
      <div class="stat-card" style="--accent:rgba(80,160,210,.4);--accent-glow:rgba(80,160,210,.12)">
        <div class="stat-label">城镇人均收入</div>
        <div class="stat-val" id="sUrban">5.48<span class="stat-unit">万</span></div>
        <div class="stat-change up" id="sUrbanChg">基年</div>
      </div>
      <div class="stat-card" style="--accent:rgba(212,160,100,.4);--accent-glow:rgba(212,160,100,.12)">
        <div class="stat-label">农村人均收入</div>
        <div class="stat-val" id="sRural">2.07<span class="stat-unit">万</span></div>
        <div class="stat-change up" id="sRuralChg">基年</div>
      </div>
      <div class="stat-card" style="--accent:rgba(160,155,180,.35);--accent-glow:rgba(160,155,180,.1)">
        <div class="stat-label">城乡收入比</div>
        <div class="stat-val" id="sRatio">2.65<span class="stat-unit">:1</span></div>
        <div class="stat-change down" id="sRatioChg">▼ 收窄趋势</div>
      </div>
      <div class="stat-card" style="--accent:rgba(120,185,170,.35);--accent-glow:rgba(120,185,170,.1)">
        <div class="stat-label">社消零售总额</div>
        <div class="stat-val" id="sRetail">3870<span class="stat-unit">亿</span></div>
        <div class="stat-change up" id="sRetailChg">基年</div>
      </div>
    </div>
  </div><!-- /page3Hud -->

  <!-- ══ Page 4: 人才着陆点 HUD ══ -->
  <div id="page4Hud" style="display:none">
    <div class="ind-title-card">
      <div class="itc-eyebrow">INNER MONGOLIA</div>
      <div class="itc-title">人才着陆点<br><span style="font-size:12px;color:rgba(160,175,195,.5)">行业薪资·需求增速·就业容量</span></div>
      <div class="itc-desc">气泡横轴 = 行业平均年薪（万）<br>纵轴 = 该行业就业需求增速<br>气泡大小 = 就业容量 · 右侧输入专业匹配行业</div>
    </div>
    <div class="stat-row">
      <div class="stat-card" style="--accent:rgba(80,160,210,.4);--accent-glow:rgba(80,160,210,.12)">
        <div class="stat-label">城镇就业人数</div>
        <div class="stat-val" id="sTalentTotal">267.7<span class="stat-unit">万</span></div>
        <div class="stat-change up" id="sTalentChg">基年</div>
      </div>
      <div class="stat-card" style="--accent:rgba(212,160,100,.4);--accent-glow:rgba(212,160,100,.12)">
        <div class="stat-label">工资总额</div>
        <div class="stat-val" id="sTalentWage">2427<span class="stat-unit">亿</span></div>
        <div class="stat-change up" id="sTalentWageChg">基年</div>
      </div>
      <div class="stat-card" style="--accent:rgba(200,180,120,.35);--accent-glow:rgba(200,180,120,.1)">
        <div class="stat-label">科研技术就业</div>
        <div class="stat-val" id="sTalentTech">5.9<span class="stat-unit">万</span></div>
        <div class="stat-change up" id="sTalentTechChg">基年</div>
      </div>
      <div class="stat-card" style="--accent:rgba(120,185,170,.35);--accent-glow:rgba(120,185,170,.1)">
        <div class="stat-label">信息技术就业</div>
        <div class="stat-val" id="sTalentIT">4.6<span class="stat-unit">万</span></div>
        <div class="stat-change up" id="sTalentITChg">基年</div>
      </div>
    </div>
  </div><!-- /page4Hud -->
</section>

<!-- ══ Page3 右侧 GDP 增长柱状图 ══ -->
<div id="page3Right" class="p3-right">
  <div class="gdp-box">
    <div class="gdp-box-title">经济增长</div>
    <div class="gdp-box-sub">地区生产总值 · 亿元</div>
    <div class="gdp-vbars" id="gdpVBars"></div>
    <div class="gdp-ind-group" id="gdpIndGroup"></div>
    <div class="gdp-metric-row" id="gdpMetrics"></div>
  </div>
</div>

<div class="right-panel">
  <div class="legend">
    <div class="legend-card" data-cat="equip"><b><i class="dot" style="color:#d4a050;background:#d4a050"></i>机电设备</b></div>
    <div class="legend-card" data-cat="rare"><b><i class="dot" style="color:#a878e0;background:#a878e0"></i>稀土新材料</b></div>
    <div class="legend-card" data-cat="chem"><b><i class="dot" style="color:#5098d8;background:#5098d8"></i>化工原料</b></div>
    <div class="legend-card" data-cat="coal"><b><i class="dot" style="color:#d08050;background:#d08050"></i>煤炭能源</b></div>
    <div class="legend-card" data-cat="green"><b><i class="dot" style="color:#00c8d0;background:#00c8d0"></i>绿电算力</b></div>
  </div>
  <div class="clear-btn" id="clearBtn">✕ 清除选择</div>
</div>

<div class="detail-panel" id="detailPanel">
  <div class="dp-header">
    <h3><span class="dp-flag">🇨🇳</span><span id="dpTitle">俄罗斯</span></h3>
    <button class="dp-close" id="dpClose">✕</button>
  </div>
  <div class="dp-sub" id="dpSub">内蒙古 2021 年双边贸易结构</div>
  <div class="dp-chart" id="dpChart"></div>
  <div class="dp-legend-row">
    <span><i style="background:rgba(212,160,80,.7)"></i>出口</span>
    <span><i style="background:rgba(92,158,245,.7)"></i>进口</span>
    <span><i style="background:rgba(255,255,255,.08)"></i>总额趋势</span>
  </div>
  <div class="dp-stats" id="dpStats"></div>
  <div class="dp-goods" id="dpGoods"></div>
</div>

<div class="energy-panel" id="energyPanel">
  <div class="ep-header">
    <h3><span id="epTitle">北京</span><span class="ep-type-badge coal" id="epBadge">煤炭</span></h3>
    <button class="ep-close" id="epClose">✕</button>
  </div>
  <div class="ep-sub" id="epSub">内蒙古 → 北京 · 能源输送概览</div>
  <div class="ep-gauges" id="epGauges"></div>
  <div class="ep-spark" id="epSpark"></div>
  <div class="ep-bars" id="epBars"></div>
  <div class="ep-info" id="epInfo"></div>
</div>

<section class="timeline">
  <div class="tl-top">
    <div>
      <div class="tl-label">Timeline / Energy Transition</div>
      <div id="yearNote">2021：外贸与煤炭主导，绿电算力通道刚刚铺开。</div>
    </div>
    <div id="yearValue">2021</div>
  </div>
  <div class="rng"><div class="rng-track"></div>
    <input id="yearSlider" type="range" min="2021" max="2024" step="1" value="2021"/>
  </div>
  <div class="ticks"><span>2021</span><span>2022</span><span>2023</span><span style="text-align:right">2024</span></div>
</section>

<div class="view-switch" id="viewSwitch">
  <span class="view-switch-label">VIEW</span>
  <button class="view-btn" id="btnDomestic" data-view="domestic">🇨🇳 国内</button>
  <button class="view-btn active" id="btnGlobal" data-view="global">🌐 国际</button>
</div>

<div id="tip"></div>
<div id="cursorGlow"></div>
<div id="cursorDot"></div>

<!-- CDN -->
<script src="https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/globe.gl@2.33.0/dist/globe.gl.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/topojson-client@3/dist/topojson-client.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>

<!-- 应用代码 -->
<script src="js/data.js"></script>
<script src="js/director.js"></script>
<script src="js/dairy.js"></script>
<script src="js/globe.js"></script>
<script src="js/pages.js"></script>
<script src="js/main.js"></script>
</body>
</html>