/* ══════════════════════════════════════════════════════
   API 数据加载层
   硬编码数据作为 fallback，API 成功后覆盖
   ══════════════════════════════════════════════════════ */
var API_BASE = window.location.origin;

function _fetchJSON(path) {
    return fetch(API_BASE + path).then(function(r) {
        if (!r.ok) throw new Error(r.status);
        return r.json();
    });
}

/* 中文指标名 → 英文 key 映射 */
var _oldEngineMap = {
    '煤炭产量(亿吨)':'coalOutput', '煤炭吨均价(元/吨)':'coalPrice',
    '采矿业人均工资(万元)':'mineWage', '采矿业工资增速(%)':'mineWageGr',
    '制造业就业(万人)':'mfgEmploy', '制造业就业增速(%)':'mfgEmployGr',
    '电力运维工资(万元)':'powerWage', '资源税(亿元)':'resTax'
};
var _newEngineMap = {
    '新能源装机(万千瓦)':'renewCap', '风电装机(万千瓦)':'windCap',
    '光伏装机(万千瓦)':'solarCap', '绿电输送(亿千瓦时)':'greenPower',
    '数据中心算力(P)':'dataCenterP', '科技财政支出(亿元)':'sciSpend',
    '信息技术投资(亿元)':'infoInvest', '高技术制造业增加值增速(%)':'hiTechGrowth',
    '新能源岗位平均工资(万元)':'renewJobWage', '储能工程师工资(万元)':'storageWage'
};
var _funnelMap = {
    'GDP总量(亿元)':'gdp', '资源型产值占GDP比(%)':'resPct',
    '财政自给率(%)':'fiscalSelf', '中央转移支付(亿元)':'transfer',
    '人口(万人)':'pop', '人口自然增长率(‰)':'popGrowth',
    '青年外流比例(%)':'youthOutflow'
};

function _mapTimeSeries(api, keyMap) {
    var r = { years: api.years || [] };
    for (var cn in api) {
        if (cn === 'years') continue;
        var en = keyMap[cn];
        if (en) r[en] = api[cn];
    }
    return r;
}

function _mergeGeo(localArr, apiArr, dataKey) {
    var m = {};
    apiArr.forEach(function(a) { m[a.cn || a.name] = a; });
    var yrs = [2021, 2022, 2023, 2024];
    localArr.forEach(function(item) {
        var a = m[item.cn || item.name];
        if (!a) return;
        if (dataKey && a[dataKey])
            item[dataKey] = yrs.map(function(y) { return a[dataKey][y] || 0; });
        if (a.exp) item.exp = yrs.map(function(y) { return a.exp[y] || 0; });
        if (a.imp) item.imp = yrs.map(function(y) { return a.imp[y] || 0; });
        if (a.goods) item.goods = a.goods;
        if (a.impG) item.impG = a.impG;
    });
}

function _rebuildYearTexts() {
    yearTexts = {
        2021: '2021：GDP ' + R.gdp[2021].total + ' 亿元，进出口 ' + fmtBn(R.trade[2021].totalK) + ' 亿美元，外贸与煤炭主导。',
        2022: '2022：GDP ' + R.gdp[2022].total + ' 亿元(+' + (R.gdp[2022].idx - 100).toFixed(1) + '%)，进出口 ' + fmtBn(R.trade[2022].totalK) + ' 亿美元，出口扩大。',
        2023: '2023：GDP ' + R.gdp[2023].total + ' 亿元(+' + (R.gdp[2023].idx - 100).toFixed(1) + '%)，进出口 ' + fmtBn(R.trade[2023].totalK) + ' 亿美元，绿电通道快速扩张。',
        2024: '2024：GDP ' + R.gdp[2024].total + ' 亿元(+' + (R.gdp[2024].idx - 100).toFixed(1) + '%)，进出口 ' + fmtBn(R.trade[2024].totalK) + ' 亿美元，结构明显转绿。'
    };
}

function loadAllData() {
    return Promise.all([
        _fetchJSON('/api/R'),                // 0
        _fetchJSON('/api/gdp-data'),         // 1
        _fetchJSON('/api/export-structure'),  // 2
        _fetchJSON('/api/import-structure'),  // 3
        _fetchJSON('/api/population'),        // 4
        _fetchJSON('/api/consumption'),       // 5
        _fetchJSON('/api/cpi'),              // 6
        _fetchJSON('/api/res-tax'),          // 7
        _fetchJSON('/api/ind-stats'),        // 8
        _fetchJSON('/api/old-engine'),       // 9
        _fetchJSON('/api/new-engine'),       // 10
        _fetchJSON('/api/funnel'),           // 11
        _fetchJSON('/api/trade-dests'),      // 12
        _fetchJSON('/api/coal-dests'),       // 13
        _fetchJSON('/api/green-dests'),      // 14
    ]).then(function(d) {
        /* 直接覆盖简单对象 */
        R              = d[0];
        gdpData        = d[1];
        exportStructure= d[2];
        importStructure= d[3];
        nmgPopulation  = d[4];
        nmgConsume     = d[5];
        nmgCPI         = d[6];
        resTax         = d[7];
        indStats       = d[8];

        /* 时间序列：中文→英文映射 */
        nmgOldEngine = _mapTimeSeries(d[9],  _oldEngineMap);
        nmgNewEngine = _mapTimeSeries(d[10], _newEngineMap);
        nmgFunnel    = _mapTimeSeries(d[11], _funnelMap);

        /* 地理数据：合并数值，保留坐标/样式元数据 */
        _mergeGeo(tradeDests, d[12], null);
        _mergeGeo(coalDests,  d[13], 'coal');
        _mergeGeo(greenDests, d[14], 'power');

        /* 重建派生数据 */
        _rebuildYearTexts();

        console.log('[loadAllData] ✅ API 数据加载完成，已覆盖本地数据');
    }).catch(function(err) {
        console.warn('[loadAllData] ⚠️ API 不可用，使用内置数据:', err.message || err);
    });
}

/* 页面加载即发起请求，在用户出发交互前完成 */
var dataReady = loadAllData();